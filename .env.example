APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Opcional. Si se define, el cliente debe enviar el header X-API-Key.
API_KEY=

# Directorio donde se guardan las descargas temporales
DOWNLOAD_DIR=./storage/downloads

MAX_CONCURRENT_DOWNLOADS=2
JOB_TTL_SECONDS=3600
MAX_DURATION_SECONDS=14400
MAX_FILE_BYTES=2147483648

# Ruta a ffmpeg si no está en PATH (ejemplo: C:\ffmpeg\bin)
FFMPEG_LOCATION=

# Archivo cookies.txt exportado del navegador (sitios que lo requieran)
COOKIES_FILE=

# Proxy opcional, por ejemplo http://127.0.0.1:7890
PROXY=
